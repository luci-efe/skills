{
  "git": {
    "bin": "git",
    "probe": [
      "git",
      "--version"
    ],
    "install": {
      "darwin": "brew install git",
      "linux": "sudo apt-get install git"
    },
    "docs": "https://git-scm.com/book/en/v2/Getting-Started-Installing-Git",
    "verified": true
  },
